INSERT INTO lookup_batting_age_regression (
age_from,
age_to,
sample_size,
pa_delta,
so_delta,
bb_delta,
1b_delta,
2b_delta,
3b_delta,
hr_delta,
sb_delta,
cs_delta
)
WITH player_pool AS (
    SELECT player_id
    FROM jaybird.player_offense_career_batting
    WHERE seasons > 9 AND pa > 2999
),

age_stats AS (
    SELECT 
        b.player_id,
        b.age,

        -- Batting
        b.pa,
        b.so,
        b.bb,
        b.1b,
        b.2b,
        b.3b,
        b.hr,

        -- Baserunning
        r.sb,
        r.cs

    FROM jaybird.player_offense_season_batting AS b
    INNER JOIN jaybird.player_offense_season_baserunning AS r
        ON b.player_id = r.player_id
       AND b.season = r.season
    WHERE b.pa > 300
      AND b.age BETWEEN 18 AND 45
      AND b.player_id IN (SELECT player_id FROM player_pool)
),

age_pairs AS (
    SELECT 
        a.player_id,
        a.age AS age_from,
        b.age AS age_to,

        -- Batting
        a.pa AS pa_a, b.pa AS pa_b,
        a.so AS so_a, b.so AS so_b,
        a.bb AS bb_a, b.bb AS bb_b,
        a.1b AS 1b_a, b.1b AS 1b_b,
        a.2b AS 2b_a, b.2b AS 2b_b,
        a.3b AS 3b_a, b.3b AS 3b_b,
        a.hr AS hr_a, b.hr AS hr_b,

        -- Baserunning
        a.sb AS sb_a, b.sb AS sb_b,
        a.cs AS cs_a, b.cs AS cs_b

    FROM age_stats AS a
    INNER JOIN age_stats AS b
      ON a.player_id = b.player_id
     AND b.age = a.age + 1
)

SELECT 
    age_from,
    age_to,
    COUNT(*) AS sample_size,

    -- Batting deltas
    (SUM(pa_b) - SUM(pa_a)) / NULLIF(SUM(pa_a),0) AS pa_delta,
    (SUM(so_b) - SUM(so_a)) / NULLIF(SUM(so_a),0) AS so_delta,
    (SUM(bb_b) - SUM(bb_a)) / NULLIF(SUM(bb_a),0) AS bb_delta,
    (SUM(1b_b) - SUM(1b_a)) / NULLIF(SUM(1b_a),0) AS 1b_delta,
    (SUM(2b_b) - SUM(2b_a)) / NULLIF(SUM(2b_a),0) AS 2b_delta,
    (SUM(3b_b) - SUM(3b_a)) / NULLIF(SUM(3b_a),0) AS 3b_delta,
    (SUM(hr_b) - SUM(hr_a)) / NULLIF(SUM(hr_a),0) AS hr_delta,

    -- Baserunning deltas
    (SUM(sb_b) - SUM(sb_a)) / NULLIF(SUM(sb_a),0) AS sb_delta,
    (SUM(cs_b) - SUM(cs_a)) / NULLIF(SUM(cs_a),0) AS cs_delta

FROM age_pairs
GROUP BY age_from, age_to
ORDER BY age_from;

INSERT INTO lookup_pitching_age_regression (
    age_from,
    age_to,
    sample_size,
    bf_delta,
    so_delta,
    bb_delta,
    1b_delta,
    2b_delta,
    3b_delta,
    hr_delta
)
WITH player_pool AS (
  SELECT player_id
    FROM jaybird.player_defense_career_pitching
    WHERE seasons > 9 AND bf > 2999
),

age_stats AS (
    SELECT
        player_id,
        age,

        -- Raw pitching event fields (NO _delta)
        bf,
        so,
        bb,
        1b,
        2b,
        3b,
        hr

    FROM jaybird.player_defense_season_pitching
    WHERE bf > 300
      AND age BETWEEN 18 AND 45
      AND player_id IN (SELECT player_id FROM player_pool)
),

age_pairs AS (
    SELECT
        a.player_id,
        a.age AS age_from,
        b.age AS age_to,

        -- Raw fields for delta math
        a.bf AS bf_a, b.bf AS bf_b,
        a.so AS so_a, b.so AS so_b,
        a.bb AS bb_a, b.bb AS bb_b,
        a.1b AS 1b_a, b.1b AS 1b_b,
        a.2b AS 2b_a, b.2b AS 2b_b,
        a.3b AS 3b_a, b.3b AS 3b_b,
        a.hr AS hr_a, b.hr AS hr_b

    FROM age_stats AS a
    INNER JOIN age_stats AS b
      ON a.player_id = b.player_id
     AND b.age = a.age + 1
)

SELECT
    age_from,
    age_to,
    COUNT(*) AS sample_size,

    -- DELTAS (output fields have _delta)
    (SUM(bf_b) - SUM(bf_a)) / NULLIF(SUM(bf_a),0) AS bf_delta,
    (SUM(so_b) - SUM(so_a)) / NULLIF(SUM(so_a),0) AS so_delta,
    (SUM(bb_b) - SUM(bb_a)) / NULLIF(SUM(bb_a),0) AS bb_delta,
    (SUM(1b_b) - SUM(1b_a)) / NULLIF(SUM(1b_a),0) AS 1b_delta,
    (SUM(2b_b) - SUM(2b_a)) / NULLIF(SUM(2b_a),0) AS 2b_delta,
    (SUM(3b_b) - SUM(3b_a)) / NULLIF(SUM(3b_a),0) AS 3b_delta,
    (SUM(hr_b) - SUM(hr_a)) / NULLIF(SUM(hr_a),0) AS hr_delta

FROM age_pairs
GROUP BY age_from, age_to
ORDER BY age_from;

INSERT INTO lookup_fielding_age_regression (
    pos,
    age_from,
    age_to,
    sample_size,
    inn_delta,
    po_delta,
    a_delta,
    e_delta
)
WITH player_pool AS (
    SELECT player_id
    FROM jaybird.player_defense_career_fielding_x_pos
    WHERE seasons > 9 AND inn > 2000
),

age_stats AS (
    SELECT
        player_id,
        pos,
        age,
        inn,
        po,
        a,
        e
    FROM jaybird.player_defense_season_fielding_x_pos
    WHERE inn > 600
      AND age BETWEEN 18 AND 45
      AND player_id IN (SELECT player_id FROM player_pool)
),

age_pairs AS (
    SELECT
        a.player_id,
        a.pos,
        a.age AS age_from,
        b.age AS age_to,

        a.inn AS inn_a, b.inn AS inn_b,
        a.po  AS po_a,  b.po  AS po_b,
        a.a   AS a_a,   b.a   AS a_b,
        a.e   AS e_a,   b.e   AS e_b
    FROM age_stats AS a
    INNER JOIN age_stats AS b
      ON a.player_id = b.player_id
     AND b.age = a.age + 1
)

SELECT
    pos,
    age_from,
    age_to,
    COUNT(*) AS sample_size,

    (SUM(inn_b) - SUM(inn_a)) / NULLIF(SUM(inn_a), 0) AS inn_delta,
    (SUM(po_b)  - SUM(po_a))  / NULLIF(SUM(po_a), 0)  AS po_delta,
    (SUM(a_b)   - SUM(a_a))   / NULLIF(SUM(a_a), 0)   AS a_delta,
    (SUM(e_b)   - SUM(e_a))   / NULLIF(SUM(e_a), 0)   AS e_delta

FROM age_pairs
GROUP BY pos, age_from, age_to
ORDER BY pos, age_from;
